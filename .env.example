# Copy to .env (git-ignored) and fill in.

# Your DR login. `npm run personal` / `npm run deploy` log in with it and bake the resulting session into the package.
# (older files used USER / PASS - those still work)
DR_USER=
DR_PASS=

# Only for `npm run deploy`: the Roku's IP (Settings > Network) and the Developer Mode webserver password.
ROKU_IP=192.168.0.0
ROKU_PASSWORD=

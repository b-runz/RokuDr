<?xml version="1.0" encoding="utf-8" ?>
<!-- Row of text buttons (first one is the red primary). Left/Right moves, OK fires `selected` with the button index. -->
<component name="ActionBar" extends="Group">
    <interface>
        <field id="labels" type="array" onChange="rebuild" />
        <field id="selected" type="integer" alwaysNotify="true" />
        <field id="index" type="integer" value="0" />
    </interface>
    <script type="text/brightscript" uri="ActionBar.brs" />
    <children>
        <Group id="items" />
        <Group id="ring" visible="false">
            <Rectangle id="ringT" color="0x000000FF" />
            <Rectangle id="ringB" color="0x000000FF" />
            <Rectangle id="ringL" color="0x000000FF" />
            <Rectangle id="ringR" color="0x000000FF" />
        </Group>
    </children>
</component>
